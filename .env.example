# ============================================================
# RevNow Query Intelligence — Environment Configuration
# Copy this file to .env and fill in actual values.
# NEVER commit .env to version control.
# ============================================================

# ----- Application -----
NODE_ENV=development
APP_URL=http://localhost:3000
PORT=3001

# ----- Authentication -----
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=REPLACE_WITH_STRONG_RANDOM_SECRET
JWT_EXPIRES_IN=7d
# Required only for the first production startup with DEMO_MODE=false.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
BOOTSTRAP_ADMIN_NAME=

# ----- MongoDB Atlas -----
# Free M0 cluster. Get from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/revnow?retryWrites=true&w=majority

# ----- Google Drive OAuth2 -----
# Create credentials at: https://console.cloud.google.com/
# Enable Drive API (free, no billing required for Drive API alone)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/integrations/drive/callback
GOOGLE_DRIVE_FOLDER_ID=

# ----- Meta WhatsApp Cloud API -----
# Set up at: https://developers.facebook.com/
# Use the test number for development — no cost.
META_ACCESS_TOKEN=
META_PHONE_NUMBER_ID=
META_WABA_ID=
META_GRAPH_API_VERSION=v20.0
META_WEBHOOK_VERIFY_TOKEN=REPLACE_WITH_RANDOM_STRING
META_APP_SECRET=
# Must be approved in WhatsApp Manager and have one body text parameter.
META_MESSAGE_TEMPLATE_NAME=
META_MESSAGE_TEMPLATE_LANGUAGE=en_US

# ----- Email -----
# Options: smtp | mock
EMAIL_PROVIDER=mock
# For real SMTP (e.g. Gmail with App Password or SendGrid free tier):
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM=noreply@revnow.local

# ----- Feature Flags -----
# Set DEMO_MODE=true to use synthetic fixtures and demo adapters.
DEMO_MODE=true

# Messaging provider: meta | mock
WHATSAPP_PROVIDER=mock

# Drive provider: google | demo
DRIVE_PROVIDER=demo

# ============================================================
# COST NOTICE: All services above have free tiers.
# Do NOT enable billing on Google Cloud unless explicitly reviewed.
# The Meta test number is for development only.
# ============================================================
