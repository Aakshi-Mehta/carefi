{
  "name": "carefi-revnow",
  "version": "1.0.0",
  "private": true,
  "description": "RevNow Query Intelligence — Care.fi Patient Locker & Automated Query Response System",
  "scripts": {
    "dev:frontend": "cd frontend && npm run dev",
    "dev:api": "cd api && npm run dev",
    "dev": "concurrently \"npm run dev:frontend\" \"npm run dev:api\"",
